    <question type="multichoice">
        <name>
            <text>Вопрос 15: Двумерный поиск ИНДЕКС+ПОИСКПОЗ</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>Какой вариант правильно объединяет <b>ИНДЕКС</b> и <b>ПОИСКПОЗ</b> для поиска значения на пересечении строки по критерию A и столбца по критерию B?</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="100">
            <text>=ИНДЕКС(таблица; ПОИСКПОЗ(крит_A; строка_критериев; 0); ПОИСКПОЗ(крит_B; столбцы_критериев; 0))</text>
        </answer>
        <answer fraction="0">
            <text>=ПОИСКПОЗ(ИНДЕКС(таблица; критерий_A; критерий_B))</text>
        </answer>
        <answer fraction="0">
            <text>=ВПР(крит_A; таблица; ПОИСКПОЗ(крит_B; заголовки; 0); 0)</text>
        </answer>
        <answer fraction="0">
            <text>=СУММЕСЛИМН(таблица; строка_критериев; крит_A; столбцы_критериев; крит_B)</text>
        </answer>
    </question>
