<?xml version="1.0" encoding="UTF-8"?>
<quiz>
    <question type="multichoice">
        <name>
            <text>Вопрос 1: Аргумент ВПР</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>Какой аргумент функции <b>ВПР</b> отвечает за то, из какой колонки нужно взять значение?</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="0">
            <text>Искомое значение</text>
        </answer>
        <answer fraction="0">
            <text>Таблица</text>
        </answer>
        <answer fraction="100">
            <text>Номер столбца</text>
        </answer>
        <answer fraction="0">
            <text>Интервальный просмотр</text>
        </answer>
    </question>

    <question type="multichoice">
        <name>
            <text>Вопрос 2: СЧЁТ</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>Какая функция посчитает <b>только ячейки с числами</b> в диапазоне A1:A10?</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="100">
            <text>=СЧЁТ(A1:A10)</text>
        </answer>
        <answer fraction="0">
            <text>=СЧЁТЗ(A1:A10)</text>
        </answer>
        <answer fraction="0">
            <text>=СЧЁТЕСЛИ(A1:A10)</text>
        </answer>
        <answer fraction="0">
            <text>=СЧЁТПУСТОТЫ(A1:A10)</text>
        </answer>
    </question>

    <question type="multichoice">
        <name>
            <text>Вопрос 3: ЕСЛИ</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>Что вернет формула <b>=ЕСЛИ(10 > 5; "Да"; "Нет")</b>?</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="100">
            <text>Да</text>
        </answer>
        <answer fraction="0">
            <text>Нет</text>
        </answer>
        <answer fraction="0">
            <text>ИСТИНА</text>
        </answer>
        <answer fraction="0">
            <text>Ошибка</text>
        </answer>
    </question>

    <question type="multichoice">
        <name>
            <text>Вопрос 4: ИНДЕКС + ПОИСКПОЗ</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>Какая связка формул заменит <b>ВПР</b> при поиске значения слева от ключевого столбца?</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="100">
            <text>=ИНДЕКС(диапазон_результата; ПОИСКПОЗ(что_ищем; диапазон_где_ищем; 0))</text>
        </answer>
        <answer fraction="0">
            <text>=ПОИСКПОЗ(ИНДЕКС(...))</text>
        </answer>
        <answer fraction="0">
            <text>=ВПР(ИНДЕКС(...))</text>
        </answer>
        <answer fraction="0">
            <text>=СУММ(ИНДЕКС(ПОИСКПОЗ(...)))</text>
        </answer>
    </question>

    <question type="multichoice">
        <name>
            <text>Вопрос 5: ГПР</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>В чем ключевое отличие <b>ГПР</b> от <b>ВПР</b>?</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="0">
            <text>ГПР ищет значения в первом столбце, ВПР — в первой строке</text>
        </answer>
        <answer fraction="100">
            <text>ГПР ищет значения в первой строке (по горизонтали), ВПР — в первом столбце (по вертикали)</text>
        </answer>
        <answer fraction="0">
            <text>ГПР всегда использует точное совпадение, ВПР — нет</text>
        </answer>
        <answer fraction="0">
            <text>ГПР не умеет работать с текстом</text>
        </answer>
    </question>

    <question type="multichoice">
        <name>
            <text>Вопрос 6: ПОИСКПОЗ тип 0</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>Что означает аргумент [тип_сопоставления] равный <b>0</b> в функции <b>ПОИСКПОЗ</b>?</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="0">
            <text>Поиск наибольшего значения, не превышающего искомое</text>
        </answer>
        <answer fraction="0">
            <text>Поиск наименьшего значения, не меньшего искомого</text>
        </answer>
        <answer fraction="100">
            <text>Поиск точного совпадения</text>
        </answer>
        <answer fraction="0">
            <text>Приблизительный поиск по возрастанию</text>
        </answer>
    </question>

    <question type="multichoice">
        <name>
            <text>Вопрос 7: Ошибка ВПР</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>Предположим, формула <b>=ВПР(100; A1:B100; 2; ЛОЖЬ)</b> не находит значение 100. Что она вернет?</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="0">
            <text>0</text>
        </answer>
        <answer fraction="0">
            <text>Пустую строку</text>
        </answer>
        <answer fraction="100">
            <text>#Н/Д (ошибка)</text>
        </answer>
        <answer fraction="0">
            <text>#ССЫЛКА!</text>
        </answer>
    </question>

    <question type="multichoice">
        <name>
            <text>Вопрос 8: ЕСЛИ + И</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>Какая формула проверит, что в ячейке A1 число от 10 до 20 включительно?</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="100">
            <text>=ЕСЛИ(И(A1>=10; A1<=20); "Да"; "Нет")</text>
        </answer>
        <answer fraction="0">
            <text>=ЕСЛИ(ИЛИ(A1>=10; A1<=20); "Да"; "Нет")</text>
        </answer>
        <answer fraction="0">
            <text>=ЕСЛИ(A1>=10 И A1<=20; "Да"; "Нет")</text>
        </answer>
        <answer fraction="0">
            <text>=ЕСЛИ(A1:10-20; "Да"; "Нет")</text>
        </answer>
    </question>

    <question type="multichoice">
        <name>
            <text>Вопрос 9: СЧЁТЕСЛИ</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>Что подсчитает формула <b>=СЧЁТЕСЛИ(B2:B100; ">100")</b>?</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="100">
            <text>Количество ячеек со значением больше 100</text>
        </answer>
        <answer fraction="0">
            <text>Количество ячеек со значением меньше 100</text>
        </answer>
        <answer fraction="0">
            <text>Количество ячеек, содержащих текст ">100"</text>
        </answer>
        <answer fraction="0">
            <text>Сумму чисел больше 100</text>
        </answer>
    </question>

    <question type="multichoice">
        <name>
            <text>Вопрос 10: Ошибка из-за номера столбца</text>
        </name>
        <questiontext format="html">
            <text><![CDATA[<p>Формула <b>=ВПР("Иванов"; A2:D50; 5; 0)</b> вернет ошибку, потому что:</p>]]></text>
        </questiontext>
        <defaultgrade>1</defaultgrade>
        <single>true</single>
        <answer fraction="0">
            <text>Искомое значение не найдено</text>
        </answer>
        <answer fraction="100">
            <text>Номер столбца (5) превышает количество столбцов в таблице (4)</text>
        </answer>
        <answer fraction="0">
            <text>Использован приблизительный поиск</text>
        </answer>
        <answer fraction="0">
            <text>В таблице нет текста "Иванов"</text>
        </answer>
    </question>

