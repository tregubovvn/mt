  <!-- Вопрос 1: Вставь пропущенное (t_ц формула) -->
  <question type="multichoice">
    <name>
      <text>Вопрос 1 - Вставь пропущенное (продолжительность цикла)</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Вставьте пропущенный элемент в формулу продолжительности цикла транспортного процесса (ездки с грузом):</p>
      <p>\[t_{\text{ц}} = \frac{L_{\text{ег}}}{\beta_{\text{е}} \cdot V_T} + \ ?\]</p>]]></text>
    </questiontext>
    <answer fraction="100">
      <text>\(t_{\text{пр}}\) (время простоя под погрузкой и разгрузкой)</text>
    </answer>
    <answer fraction="0">
      <text>\(L_{\text{м}}\) (длина маршрута)</text>
    </answer>
    <answer fraction="0">
      <text>\(n_{\text{з}} \cdot t_{\text{з}}\) (время на заезды)</text>
    </answer>
    <answer fraction="0">
      <text>\(q_{\text{ф}}\) (фактическая загрузка)</text>
    </answer>
  </question>

  <!-- Вопрос 2: Сопоставление 1 (название показателя -> формула) -->
  <question type="multichoice">
    <name>
      <text>Вопрос 2 - Часовая производительность автомобиля</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Выберите формулу, которая позволяет рассчитать <strong>часовую производительность автомобиля</strong> (\(W_{\text{ач}}\)).</p>]]></text>
    </questiontext>
    <answer fraction="100">
      <text>\(W_{\text{ач}} = \frac{q \cdot \gamma_{\text{с}}}{t_{\text{ц}}}\)</text>
    </answer>
    <answer fraction="0">
      <text>\(W_{\text{ач}} = \frac{L_{\text{ег}}}{\beta_{\text{е}} \cdot V_T}\)</text>
    </answer>
    <answer fraction="0">
      <text>\(W_{\text{ач}} = \frac{1}{t_{\text{о}}}\)</text>
    </answer>
    <answer fraction="0">
      <text>\(W_{\text{ач}} = q \cdot \gamma_{\text{с}}\)</text>
    </answer>
  </question>

