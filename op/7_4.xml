<formulas>
    <formula name="Вместимость склада">
        <latex> E_{c} = 10^{-2} F_{пол} e </latex>
        <symbols>
            <symbol char="E_{c}" name="Вместимость склада, т" />
            <symbol char="F_{пол}" name="Полезная площадь склада, м^2" />
            <symbol char="e" name="Нагрузка на 1 м^2 площади склада, кПа" />
        </symbols>
    </formula>
    <formula name="Полезная площадь склада для грузов без упаковки">
        <latex> F_{пол} = (Q_{хр} t_{хр}) / (100 e) </latex>
        <symbols>
            <symbol char="F_{пол}" name="Полезная площадь склада, м^2" />
            <symbol char="Q_{хр}" name="Масса хранимого груза, т" />
            <symbol char="t_{хр}" name="Время хранения груза, сут" />
            <symbol char="e" name="Нагрузка на 1 м^2 площади склада, кПа" />
        </symbols>
    </formula>
    <formula name="Полезная площадь склада для грузов в таре">
        <latex> F_{пол} = (f_{c} n_{хр} k_{n}) / z_{a} </latex>
        <symbols>
            <symbol char="F_{пол}" name="Полезная площадь склада, м^2" />
            <symbol char="f_{c}" name="Площадь основания хранимой тары, м^2" />
            <symbol char="n_{хр}" name="Число мест хранения" />
            <symbol char="k_{n}" name="Коэффициент плотности укладки (1,05...1,20)" />
            <symbol char="z_{a}" name="Число ярусов хранения" />
        </symbols>
    </formula>
    <formula name="Полезная площадь склада через суточный объем переработки">
        <latex> F_{пол} = (10 Q_{сут} t_{хр}) / e </latex>
        <symbols>
            <symbol char="F_{пол}" name="Полезная площадь склада, м^2" />
            <symbol char="Q_{сут}" name="Суточный объем переработки груза на складе" />
            <symbol char="t_{хр}" name="Время хранения груза, сут" />
            <symbol char="e" name="Нагрузка на 1 м^2 площади склада, кПа" />
        </symbols>
    </formula>
    <formula name="Удельный грузооборот склада">
        <latex> Q_{уд} = Q_{c} / S_{c} </latex>
        <symbols>
            <symbol char="Q_{уд}" name="Удельный грузооборот склада" />
            <symbol char="Q_{c}" name="Грузооборот склада" />
            <symbol char="S_{c}" name="Складская площадь, м^2" />
        </symbols>
    </formula>
    <formula name="Техническая вместимость склада">
        <latex> E_{Т} = (Q_{г} t_{хр} K_{Е}) / T </latex>
        <symbols>
            <symbol char="E_{Т}" name="Техническая вместимость склада, т" />
            <symbol char="Q_{г}" name="Масса грузов, проходящих через склад, т" />
            <symbol char="t_{хр}" name="Время хранения грузов на складе, сут" />
            <symbol char="K_{Е}" name="Коэффициент вместимости склада" />
            <symbol char="T" name="Период работы склада, сут" />
        </symbols>
    </formula>
    <formula name="Масса грузов, проходящих через склад">
        <latex> Q_{г} = (Q_{год} K_{пр}) / N_{ПРП} </latex>
        <symbols>
            <symbol char="Q_{г}" name="Масса грузов, проходящих через склад, т" />
            <symbol char="Q_{год}" name="Годовой грузооборот района, т" />
            <symbol char="K_{пр}" name="Коэффициент прохождения грузов через склад (0,7-1)" />
            <symbol char="N_{ПРП}" name="Количество погрузочно-разгрузочных постов (ПРП)" />
        </symbols>
    </formula>
    <formula name="Коэффициент вместимости склада">
        <latex> K_{Е} = E_{п} / E_{Т} </latex>
        <symbols>
            <symbol char="K_{Е}" name="Коэффициент вместимости склада" />
            <symbol char="E_{п}" name="Плановая вместимость склада" />
            <symbol char="E_{Т}" name="Техническая вместимость склада, т" />
        </symbols>
    </formula>
    <formula name="Полезная площадь в закрытых и открытых складских площадях">
        <latex> S_{п} = E_{Т} / (q K_{П}) </latex>
        <symbols>
            <symbol char="S_{п}" name="Полезная площадь в закрытых и открытых складских площадях, м^2" />
            <symbol char="E_{Т}" name="Техническая вместимость склада, т" />
            <symbol char="q" name="Технологическая нагрузка от складируемого груза, т/м^2" />
            <symbol char="K_{П}" name="Коэффициент использования площади склада" />
        </symbols>
    </formula>
    <formula name="Коэффициент использования площади склада">
        <latex> K_{П} = S_{г} / S_{с} </latex>
        <symbols>
            <symbol char="K_{П}" name="Коэффициент использования площади склада" />
            <symbol char="S_{г}" name="Площадь склада, занятого конкретным грузом, м^2" />
            <symbol char="S_{с}" name="Полезная площадь в крытых и открытых складских площадях, м^2" />
        </symbols>
    </formula>
    <formula name="Пропускная способность склада (первая формула)">
        <latex> P_{скл} = E_{Т} K_{о} </latex>
        <symbols>
            <symbol char="P_{скл}" name="Пропускная способность склада" />
            <symbol char="E_{Т}" name="Техническая вместимость склада, т (м^2)" />
            <symbol char="K_{о}" name="Коэффициент оборачиваемости грузов на складе" />
        </symbols>
    </formula>
    <formula name="Пропускная способность склада (вторая формула)">
        <latex> P_{скл} = (q_{Н} S_{с}) / (K_{н} t_{хр}) </latex>
        <symbols>
            <symbol char="P_{скл}" name="Пропускная способность склада" />
            <symbol char="q_{Н}" name="Нормативная нагрузка на пол склада, т/м" />
            <symbol char="S_{с}" name="Полезная площадь в крытых и открытых складских площадях, м^2" />
            <symbol char="K_{н}" name="Коэффициент неравномерности прибытия и отправления грузов на склад" />
            <symbol char="t_{хр}" name="Время хранения груза на складе, сут" />
        </symbols>
    </formula>
</formulas>