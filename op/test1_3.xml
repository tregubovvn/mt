    <answer fraction="0">
      <text>\(L_{Q} = L_{eг} \cdot \frac{\gamma_{\text{с}}}{\gamma_{\text{д}}}\)</text>
    </answer>
    <answer fraction="0">
      <text>\(L_{Q} = \frac{q_{\text{ф}}}{q}\)</text>
    </answer>
  </question>

