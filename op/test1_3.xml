  <!-- Вопрос 4: Вставь пропущенное (Коэффициент использования пробега за день) -->
  <question type="multichoice">
    <name>
      <text>Пропуск: Бета через Бета_е</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Вставьте пропущенный элемент в формулу коэффициента использования пробега за рабочий день:</p>
      <p>\(\beta = \frac{?}{1 + w}\)</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Правильный ответ: \(\beta_{e}\). Формула выглядит так: \(\beta = \frac{\beta_{e}}{1 + w}\).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <answer fraction="100">
      <text><![CDATA[<p>\(\beta_{e}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(L_{г}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(L_{ег}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(Z_{e}\)</p>]]></text>
    </answer>
  </question>

  <!-- Вопрос 5: Сопоставление 1 (Формула статического коэффициента) -->
  <question type="multichoice">
    <name>
      <text>Статический коэффициент за ездку</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Какая формула соответствует статическому коэффициенту использования грузоподъемности за одну ездку (\(\gamma_{\text{с}}\))?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Статический коэффициент за ездку: \(\gamma_{\text{с}} = \frac{q_{\text{ф}}}{q}\).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <answer fraction="100">
      <text><![CDATA[<p>\(\gamma_{\text{с}} = \frac{q_{\text{ф}}}{q}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(\gamma_{\text{с}} = \frac{P}{q \cdot L_{\text{г}}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(\gamma_{\text{с}} = \frac{q_{\text{ф}} \cdot L_{er}}{q \cdot L_{er}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(\gamma_{\text{с}} = \frac{W_{Q}}{q \cdot Z_{e}}\)</p>]]></text>
    </answer>
  </question>

