  <!-- Вопрос 8: Сопоставление 1 (Формула среднего расстояния перевозки) -->
  <question type="multichoice">
    <name>
      <text>Среднее расстояние перевозки</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Выберите верную формулу для расчета среднего расстояния перевозки одной тонны груза (\(L_{Q}\)):</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>\(L_{Q} = \frac{P}{W_{Q}}\), где \(P\) — грузооборот (т·км), \(W_{Q}\) — объем перевозок (т).</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0</defaultgrade>
    <single>true</single>
    <answer fraction="100">
      <text><![CDATA[<p>\(L_{Q} = \frac{P}{W_{Q}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(L_{Q} = \frac{L_{\text{г}}}{Z_{e}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(L_{Q} = L_{eг} \cdot \frac{\gamma_{\text{с}}}{\gamma_{\text{д}}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(L_{Q} = \frac{q_{\text{ф}}}{q}\)</p>]]></text>
    </answer>
  </question>

