<formulas>
    <formula name="Количество циклов (ездок с грузом) за один час работы">
        <latex> Z_{ц} = 1 / t_{ц} </latex>
        <symbols>
            <symbol char="Z_{ц}" name="Число циклов транспортного процесса" />
            <symbol char="t_{ц}" name="Продолжительность цикла транспортного процесса, ч" />
        </symbols>
    </formula>
    <formula name="Часовая производительность автомобиля (через фактическую загрузку)">
        <latex> W_{ач} = q_{ф} / t_{ц} </latex>
        <symbols>
            <symbol char="W_{ач}" name="Часовая производительность автомобиля, т/ч" />
            <symbol char="q_{ф}" name="Фактическая загрузка автомобиля, т" />
            <symbol char="t_{ц}" name="Продолжительность цикла транспортного процесса, ч" />
        </symbols>
    </formula>
    <formula name="Продолжительность цикла транспортного процесса (ездки с грузом)">
        <latex> t_{ц} = L_{ег} / (β_{е} * V_{T}) + t_{пр} </latex>
        <symbols>
            <symbol char="L_{ег}" name="Длина ездки с грузом, км" />
            <symbol char="β_{е}" name="Коэффициент использования пробега за одну ездку" />
            <symbol char="V_{T}" name="Техническая скорость, км/ч" />
            <symbol char="t_{пр}" name="Время простоя автомобиля под погрузкой и разгрузкой за один цикл, ч" />
        </symbols>
    </formula>
    <formula name="Фактическая загрузка автомобиля">
        <latex> q_{ф} = q * γ_{с} </latex>
        <symbols>
            <symbol char="q_{ф}" name="Фактическая загрузка автомобиля, т" />
            <symbol char="q" name="Номинальная грузоподъемность автомобиля, т" />
            <symbol char="γ_{с}" name="Статический коэффициент использования грузоподъемности" />
        </symbols>
    </formula>
    <formula name="Часовая производительность автомобиля (через грузоподъемность и коэффициент)">
        <latex> W_{ач} = (q * γ_{с}) / t_{ц} </latex>
        <symbols>
            <symbol char="W_{ач}" name="Часовая производительность автомобиля, т/ч" />
            <symbol char="q" name="Номинальная грузоподъемность автомобиля, т" />
            <symbol char="γ_{с}" name="Статический коэффициент использования грузоподъемности" />
            <symbol char="t_{ц}" name="Продолжительность цикла транспортного процесса, ч" />
        </symbols>
    </formula>
    <formula name="Время оборота подвижного состава на кольцевом маршруте">
        <latex> t_{о} = L_{м} / V_{T} + t_{пр} </latex>
        <symbols>
            <symbol char="t_{о}" name="Время оборота подвижного состава на кольцевом маршруте, ч" />
            <symbol char="L_{м}" name="Общая длина кольцевого маршрута, км" />
            <symbol char="V_{T}" name="Техническая скорость, км/ч" />
            <symbol char="t_{пр}" name="Простой под погрузкой-разгрузкой в каждом пункте, ч" />
        </symbols>
    </formula>
    <formula name="Время оборота подвижного состава на сборном (развозочном) маршруте">
        <latex> t_{о} = L_{м} / V_{T} + t_{пр} + n_{з} * t_{з} </latex>
        <symbols>
            <symbol char="t_{о}" name="Время оборота подвижного состава на сборном маршруте, ч" />
            <symbol char="L_{м}" name="Длина маршрута, км" />
            <symbol char="V_{T}" name="Техническая скорость, км/ч" />
            <symbol char="t_{пр}" name="Время на погрузку-разгрузку, ч" />
            <symbol char="n_{з}" name="Число заездов на промежуточные пункты маршрута" />
            <symbol char="t_{з}" name="Время на каждый заезд, ч" />
        </symbols>
    </formula>
    <formula name="Число оборотов за один час работы на маршруте">
        <latex> Z_{о} = 1 / t_{о} </latex>
        <symbols>
            <symbol char="Z_{о}" name="Число оборотов за один час работы на маршруте" />
            <symbol char="t_{о}" name="Время оборота, ч" />
        </symbols>
    </formula>
</formulas>