<quiz>
  <question type="multichoice">
    <name>
      <text>Вопрос 1</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>1. К подвижному составу грузового автомобильного транспорта НЕ относится:</p>]]></text>
    </questiontext>
    <answer fraction="100">
      <text>г) железнодорожная платформа</text>
    </answer>
    <answer fraction="0">
      <text>а) автомобиль-тягач</text>
    </answer>
    <answer fraction="0">
      <text>б) полуприцеп</text>
    </answer>
    <answer fraction="0">
      <text>в) прицеп-роспуски</text>
    </answer>
  </question>
  <question type="multichoice">
    <name>
      <text>Вопрос 2</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>2. Основное назначение конструкции автотранспортного средства при выборе подвижного состава — это:</p>]]></text>
    </questiontext>
    <answer fraction="100">
      <text>б) качественная перевозка грузов при минимальных затратах</text>
