<formulas>
    <formula name="Плотность груза">
        <latex> \rho_{г} = m / V </latex>
        <symbols>
            <symbol char="m" name="Масса однородного груза, кг" />
            <symbol char="V" name="Объем груза, м^{3}" />
        </symbols>
    </formula>

    <formula name="Относительная плотность груза">
        <latex> \rho_{отн} = \rho_{г} / \rho_{0г} </latex>
        <symbols>
            <symbol char="\rho_{г}" name="Плотность груза, кг/м^{3}" />
            <symbol char="\rho_{0г}" name="Плотность стандартного груза, кг/м^{3}" />
        </symbols>
    </formula>

    <formula name="Плотность нефтепродуктов при изменении температуры">
        <latex> \rho_{н}' = \rho_{н}^{0} - \Delta (t - t_{0}) </latex>
        <symbols>
            <symbol char="\rho_{н}^{0}" name="Плотность нефтепродуктов при температуре t_{0}, кг/м^{3}" />
            <symbol char="\Delta" name="Средняя температурная поправка, кг/(м^{3}·°С)" />
            <symbol char="t" name="Текущая температура, °С" />
            <symbol char="t_{0}" name="Начальная температура, °С" />
        </symbols>
    </formula>

    <formula name="Удельный объем груза">
        <latex> V_{уд} = V / m </latex>
        <symbols>
            <symbol char="V" name="Объем груза, м^{3}" />
            <symbol char="m" name="Масса груза, кг" />
        </symbols>
    </formula>

    <formula name="Удельная объемная грузоподъемность">
        <latex> \gamma_{уд} = q / (a \cdot b \cdot (h + h')) </latex>
        <symbols>
            <symbol char="q" name="Номинальная грузоподъемность, т" />
            <symbol char="a" name="Внутренняя ширина кузова, м" />
            <symbol char="b" name="Внутренняя длина кузова, м" />
            <symbol char="h" name="Внутренняя высота кузова, м" />
            <symbol char="h'" name="Расстояние от верхнего края борта до допустимого уровня загрузки, м" />
        </symbols>
    </formula>

    <formula name="Статический коэффициент использования грузоподъемности">
        <latex> \gamma_{с} = q_{ф} / q </latex>
        <symbols>
            <symbol char="q_{ф}" name="Количество фактически перевезенного груза за ездку, т" />
            <symbol char="q" name="Номинальная грузоподъемность подвижного состава, т" />
        </symbols>
    </formula>

    <formula name="Динамический коэффициент использования грузоподъемности">
        <latex> \gamma_{д} = (q_{ф} \cdot L_{ег}) / (q \cdot L_{ег}) </latex>
        <symbols>
            <symbol char="q_{ф}" name="Количество фактически перевезенного груза за ездку, т" />
            <symbol char="L_{ег}" name="Длина ездки с грузом, км" />
            <symbol char="q" name="Номинальная грузоподъемность автомобиля, т" />
        </symbols>
    </formula>

    <formula name="Статический коэффициент использования грузоподъемности (через объем кузова)">
        <latex> \gamma_{с} = \gamma_{v} \cdot (\rho_{г} / \gamma_{уд}) </latex>
        <symbols>
            <symbol char="\gamma_{v}" name="Коэффициент использования объема кузова" />
            <symbol char="\rho_{г}" name="Объемная масса груза, т/м^{3}" />
            <symbol char="\gamma_{уд}" name="Удельная объемная грузоподъемность, т/м^{3}" />
        </symbols>
    </formula>

    <formula name="Объем перевозимого груза с учетом шапки">
        <latex> V_{г} = q / \rho_{г} + V_{ш} </latex>
        <symbols>
            <symbol char="q" name="Номинальная грузоподъемность автомобиля, т" />
            <symbol char="\rho_{г}" name="Объемная масса груза, т/м^{3}" />
            <symbol char="V_{ш}" name="Объем шапки груза, м^{3}" />
        </symbols>
    </formula>
</formulas>
