<formulas>
    <formula name="Время выполнения ездки">
        <latex> t_{е} = l_{е} / v_{T} + t_{п-р} </latex>
        <symbols>
            <symbol char="t_{е}" name="Время выполнения ездки, ч" />
            <symbol char="l_{е}" name="Длина ездки, км" />
            <symbol char="v_{T}" name="Техническая скорость, км/ч" />
            <symbol char="t_{п-р}" name="Время погрузки и разгрузки, ч" />
        </symbols>
    </formula>
    <formula name="Время оборота автомобиля">
        <latex> t_{о} = 2 L_{г} / v_{T} + t_{п-р} </latex>
        <symbols>
            <symbol char="t_{о}" name="Время оборота автомобиля, ч" />
            <symbol char="L_{г}" name="Длина груженого пробега за ездку, км" />
            <symbol char="v_{T}" name="Техническая скорость, км/ч" />
            <symbol char="t_{п-р}" name="Время погрузки и разгрузки, ч" />
        </symbols>
    </formula>
    <formula name="Время движения с учетом коэффициента использования пробега">
        <latex> t_{дв} = l_{е} / (β v_{T}) </latex>
        <symbols>
            <symbol char="t_{дв}" name="Время движения, ч" />
            <symbol char="l_{е}" name="Длина ездки, км" />
            <symbol char="β" name="Коэффициент использования пробега" />
            <symbol char="v_{T}" name="Техническая скорость, км/ч" />
        </symbols>
    </formula>
    <formula name="Время на маршруте (смены)">
        <latex> T_{м} = t_{е} n_{е} + t_{н} </latex>
        <symbols>
            <symbol char="T_{м}" name="Время на маршруте (смены), ч" />
            <symbol char="t_{е}" name="Время выполнения ездки, ч" />
            <symbol char="n_{е}" name="Количество ездок за время в наряде" />
            <symbol char="t_{н}" name="Время нулевого пробега, ч" />
        </symbols>
    </formula>
    <formula name="Количество ездок за время в наряде">
        <latex> n_{е} = (T_{н} - t_{н}) / t_{е} </latex>
        <symbols>
            <symbol char="n_{е}" name="Количество ездок за время в наряде" />
            <symbol char="T_{н}" name="Время в наряде (продолжительность работы на линии), ч" />
            <symbol char="t_{н}" name="Время нулевого пробега, ч" />
            <symbol char="t_{е}" name="Время выполнения ездки, ч" />
        </symbols>
    </formula>
    <formula name="Время простоя под погрузкой-разгрузкой при механизированной обработке">
        <latex> t_{п-р} = q / P </latex>
        <symbols>
            <symbol char="t_{п-р}" name="Время погрузки и разгрузки, ч" />
            <symbol char="q" name="Масса груза за ездку, т" />
            <symbol char="P" name="Производительность погрузочно-разгрузочного оборудования, т/ч" />
        </symbols>
    </formula>
    <formula name="Техническая скорость движения">
        <latex> v_{T} = L / t_{дв} </latex>
        <symbols>
            <symbol char="v_{T}" name="Техническая скорость, км/ч" />
            <symbol char="L" name="Общий пробег за ездку, км" />
            <symbol char="t_{дв}" name="Время движения, ч" />
        </symbols>
    </formula>
    <formula name="Эксплуатационная скорость">
        <latex> v_{э} = β v_{T} t_{дв} / T_{н} </latex>
        <symbols>
            <symbol char="v_{э}" name="Эксплуатационная скорость, км/ч" />
            <symbol char="β" name="Коэффициент использования пробега" />
            <symbol char="v_{T}" name="Техническая скорость, км/ч" />
            <symbol char="t_{дв}" name="Время движения, ч" />
            <symbol char="T_{н}" name="Время в наряде (продолжительность работы на линии), ч" />
        </symbols>
    </formula>
    <formula name="Время ожидания погрузки/разгрузки">
        <latex> t_{ож} = 1/μ - 1/λ </latex>
        <symbols>
            <symbol char="t_{ож}" name="Время ожидания погрузки/разгрузки, ч" />
            <symbol char="μ" name="Интенсивность обслуживания, авт/ч" />
            <symbol char="λ" name="Интенсивность поступления автомобилей, авт/ч" />
        </symbols>
    </formula>
</formulas>