<formulas>
    <formula name="Коэффициент использования пробега (первая формула)">
        <latex> β = L_{г} / L_{сс} </latex>
        <symbols>
            <symbol char="L_{г}" name="Пробег автомобиля с грузом, км" />
            <symbol char="L_{сс}" name="Общий (среднесуточный) пробег автомобиля, км" />
        </symbols>
    </formula>
    <formula name="Коэффициент использования пробега (вторая формула)">
        <latex> β = L_{г} / (L_{г} + L_{х} + L_{0}) </latex>
        <symbols>
            <symbol char="L_{г}" name="Пробег автомобиля с грузом, км" />
            <symbol char="L_{х}" name="Пробег автомобиля без груза, км" />
            <symbol char="L_{0}" name="Нулевой пробег автомобиля, км" />
        </symbols>
    </formula>
    <formula name="Коэффициент нулевых пробегов">
        <latex> α_{0} = L_{0} / L_{сс} </latex>
        <symbols>
            <symbol char="L_{0}" name="Нулевой пробег автомобиля, км" />
            <symbol char="L_{сс}" name="Общий (среднесуточный) пробег автомобиля, км" />
        </symbols>
    </formula>
    <formula name="Пробег автомобиля с грузом">
        <latex> L_{г} = Z_{e} * L_{eг} * β_{e} </latex>
        <symbols>
            <symbol char="Z_{e}" name="Число ездок за рабочий день" />
            <symbol char="L_{eг}" name="Средняя длина ездки с грузом, км" />
            <symbol char="β_{e}" name="Коэффициент использования пробега за ездку" />
        </symbols>
    </formula>
    <formula name="Общий пробег за день работы (первая формула)">
        <latex> L_{сс} = Z_{e} * L_{eг} * β_{e} + L_{0} </latex>
        <symbols>
            <symbol char="Z_{e}" name="Число ездок за рабочий день" />
            <symbol char="L_{eг}" name="Средняя длина ездки с грузом, км" />
            <symbol char="β_{e}" name="Коэффициент использования пробега за ездку" />
            <symbol char="L_{0}" name="Нулевой пробег автомобиля за рабочий день, км" />
        </symbols>
    </formula>
    <formula name="Общий пробег за день работы (вторая формула)">
        <latex> L_{сс} = Z_{e} * L_{eг} * β_{e} * (1 + w) </latex>
        <symbols>
            <symbol char="Z_{e}" name="Число ездок за рабочий день" />
            <symbol char="L_{eг}" name="Средняя длина ездки с грузом, км" />
            <symbol char="β_{e}" name="Коэффициент использования пробега за ездку" />
            <symbol char="w" name="Коэффициент нулевых пробегов" />
        </symbols>
    </formula>
    <formula name="Коэффициент использования пробега за рабочий день">
        <latex> β = β_{e} / (1 + w) </latex>
        <symbols>
            <symbol char="β_{e}" name="Коэффициент использования пробега за ездку" />
            <symbol char="w" name="Коэффициент нулевых пробегов" />
        </symbols>
    </formula>
    <formula name="Статический коэффициент использования грузоподъемности за одну ездку с грузом">
        <latex> γ_{с} = q_{ф} / q </latex>
        <symbols>
            <symbol char="q_{ф}" name="Количество фактически перевезенного груза за ездку, т" />
            <symbol char="q" name="Номинальная грузоподъемность подвижного состава, т" />
        </symbols>
    </formula>
    <formula name="Статический коэффициент использования грузоподъемности за день">
        <latex> γ_{с} = W_{Q} / (q * Z_{e}) </latex>
        <symbols>
            <symbol char="W_{Q}" name="Объем перевозок, т" />
            <symbol char="q" name="Номинальная грузоподъемность подвижного состава, т" />
            <symbol char="Z_{e}" name="Число ездок за рабочий день" />
        </symbols>
    </formula>
    <formula name="Коэффициент динамического использования грузоподъемности за одну ездку с грузом">
        <latex> γ_{д} = q_{ф} / q </latex>
        <symbols>
            <symbol char="q_{ф}" name="Количество фактически перевезенного груза за ездку, т" />
            <symbol char="q" name="Номинальная грузоподъемность автомобиля, т" />
        </symbols>
    </formula>
    <formula name="Коэффициент динамического использования грузоподъемности за день работы">
        <latex> γ_{д} = P / (q * L_{г}) </latex>
        <symbols>
            <symbol char="P" name="Грузооборот, т·км" />
            <symbol char="q" name="Номинальная грузоподъемность автомобиля, т" />
            <symbol char="L_{г}" name="Пробег с грузом, км" />
        </symbols>
    </formula>
    <formula name="Средняя длина ездки с грузом">
        <latex> L_{eг} = L_{г} / Z_{e} </latex>
        <symbols>
            <symbol char="L_{г}" name="Пробег с грузом, км" />
            <symbol char="Z_{e}" name="Число ездок" />
        </symbols>
    </formula>
    <formula name="Среднее расстояние перевозки одной тонны груза">
        <latex> L_{Q} = P / W_{Q} </latex>
        <symbols>
            <symbol char="P" name="Грузооборот, т·км" />
            <symbol char="W_{Q}" name="Объем перевозок, т" />
        </symbols>
    </formula>
    <formula name="Средняя длина ездки с грузом через коэффициенты использования грузоподъемности">
        <latex> L_{eг} = L_{Q} * (γ_{д} / γ_{с}) </latex>
        <symbols>
            <symbol char="L_{Q}" name="Среднее расстояние перевозки одной тонны груза, км" />
            <symbol char="γ_{д}" name="Коэффициент динамического использования грузоподъемности" />
            <symbol char="γ_{с}" name="Коэффициент статического использования грузоподъемности" />
        </symbols>
    </formula>
</formulas>