<formulas>
    <formula name="Коэффициент использования пробега">
        <latex> \beta = L_{г} / L_{общ} </latex>
        <symbols>
            <symbol char="L_{г}" name="Пробег автомобиля с грузом, км" />
            <symbol char="L_{общ}" name="Общий пробег автомобиля, км" />
        </symbols>
    </formula>
    <formula name="Коэффициент использования пробега за ездку">
        <latex> \beta_{е} = l_{ег} / (l_{ег} + l_{х}) </latex>
        <symbols>
            <symbol char="l_{ег}" name="Пробег с грузом за ездку, км" />
            <symbol char="l_{х}" name="Пробег без груза за ездку, км" />
        </symbols>
    </formula>
    <formula name="Коэффициент использования пробега за рабочий день">
        <latex> \beta_{рд} = L_{г} / (L_{г} + L_{х} + L_{н}) </latex>
        <symbols>
            <symbol char="L_{г}" name="Пробег автомобиля с грузом за рабочий день, км" />
            <symbol char="L_{х}" name="Пробег автомобиля без груза за рабочий день, км" />
            <symbol char="L_{н}" name="Нулевой пробег за рабочий день, км" />
        </symbols>
    </formula>
    <formula name="Время пребывания АТС в наряде">
        <latex> T_{н} = T_{м} + t_{н} </latex>
        <symbols>
            <symbol char="T_{м}" name="Время работы на маршруте, ч" />
            <symbol char="t_{н}" name="Время на выполнение нулевого пробега, ч" />
        </symbols>
    </formula>
    <formula name="Время работы на маршруте (через время движения и время погрузки-разгрузки)">
        <latex> T_{м} = \sum t_{дв} + \sum t_{п-р} </latex>
        <symbols>
            <symbol char="t_{дв}" name="Время движения, ч" />
            <symbol char="t_{п-р}" name="Время погрузки-разгрузки, ч" />
        </symbols>
    </formula>
    <formula name="Время работы на маршруте (через пробег и техническую скорость)">
        <latex> T_{м} = (L_{г} + L_{х}) / v_{T} + \sum t_{п-р} </latex>
        <symbols>
            <symbol char="L_{г}" name="Пробег с грузом, км" />
            <symbol char="L_{х}" name="Пробег без груза, км" />
            <symbol char="v_{T}" name="Техническая скорость, км/ч" />
            <symbol char="t_{п-р}" name="Время погрузки-разгрузки, ч" />
        </symbols>
    </formula>
    <formula name="Время работы на маршруте (через общий пробег и эксплуатационную скорость)">
        <latex> T_{м} = L_{общ} / v_{э} </latex>
        <symbols>
            <symbol char="L_{общ}" name="Общий пробег, км" />
            <symbol char="v_{э}" name="Эксплуатационная скорость, км/ч" />
        </symbols>
    </formula>
    <formula name="Время работы на маршруте (через количество ездок)">
        <latex> T_{м} = n_{е} ( (l_{ег} + l_{х}) / v_{T} + t_{п-р} ) </latex>
        <symbols>
            <symbol char="n_{е}" name="Количество ездок, выполняемых ПС за смену" />
            <symbol char="l_{ег}" name="Пробег с грузом за ездку, км" />
            <symbol char="l_{х}" name="Пробег без груза за ездку, км" />
            <symbol char="v_{T}" name="Техническая скорость, км/ч" />
            <symbol char="t_{п-р}" name="Время погрузки-разгрузки, ч" />
        </symbols>
    </formula>
    <formula name="Время работы на маршруте (через количество ездок и коэффициент использования пробега)">
        <latex> T_{м} = n_{е} ( l_{ег} / (\beta_{е} v_{T}) + t_{п-р} ) </latex>
        <symbols>
            <symbol char="n_{е}" name="Количество ездок, выполняемых ПС за смену" />
            <symbol char="l_{ег}" name="Пробег с грузом за ездку, км" />
            <symbol char="\beta_{е}" name="Коэффициент использования пробега за ездку" />
            <symbol char="v_{T}" name="Техническая скорость, км/ч" />
            <symbol char="t_{п-р}" name="Время погрузки-разгрузки, ч" />
        </symbols>
    </formula>
    <formula name="Количество ездок (через время работы на маршруте и время ездки)">
        <latex> n_{е} = T_{м} / t_{е} </latex>
        <symbols>
            <symbol char="T_{м}" name="Время работы на маршруте, ч" />
            <symbol char="t_{е}" name="Время одной ездки, ч" />
        </symbols>
    </formula>
    <formula name="Количество ездок (через время работы на маршруте и параметры ездки)">
        <latex> n_{е} = T_{м} / ( l_{ег} / (\beta_{е} v_{T}) + t_{п-р} ) </latex>
        <symbols>
            <symbol char="T_{м}" name="Время работы на маршруте, ч" />
            <symbol char="l_{ег}" name="Пробег с грузом за ездку, км" />
            <symbol char="\beta_{е}" name="Коэффициент использования пробега за ездку" />
            <symbol char="v_{T}" name="Техническая скорость, км/ч" />
            <symbol char="t_{п-р}" name="Время погрузки-разгрузки, ч" />
        </symbols>
    </formula>
    <formula name="Производительность за одну ездку в тоннах">
        <latex> U_{е} = q_{н} \gamma </latex>
        <symbols>
            <symbol char="q_{н}" name="Номинальная грузоподъемность автомобиля, т" />
            <symbol char="\gamma" name="Коэффициент использования грузоподъемности" />
        </symbols>
    </formula>
    <formula name="Производительность за одну ездку в тонна-километрах">
        <latex> W_{е} = U_{е} l_{ег} </latex>
        <symbols>
            <symbol char="U_{е}" name="Производительность за одну ездку в тоннах, т" />
            <symbol char="l_{ег}" name="Пробег с грузом за ездку, км" />
        </symbols>
    </formula>
    <formula name="Часовая производительность (через количество ездок)">
        <latex> U_{р.д} = n_{е} q_{ф} </latex>
        <symbols>
            <symbol char="n_{е}" name="Количество ездок, выполняемых ПС за смену" />
            <symbol char="q_{ф}" name="Фактическая загрузка автомобиля, т" />
        </symbols>
    </formula>
    <formula name="Часовая производительность в тонна-километрах (через количество ездок)">
        <latex> W_{р.д} = n_{е} q_{ф} l_{ег} </latex>
        <symbols>
            <symbol char="n_{е}" name="Количество ездок, выполняемых ПС за смену" />
            <symbol char="q_{ф}" name="Фактическая загрузка автомобиля, т" />
            <symbol char="l_{ег}" name="Пробег с грузом за ездку, км" />
        </symbols>
    </formula>
    <formula name="Часовая производительность в тонна-километрах (общая формула)">
        <latex> W_{ч} = (q_{н} \gamma l_{ег}) / t_{е} </latex>
        <symbols>
            <symbol char="q_{н}" name="Номинальная грузоподъемность автомобиля, т" />
            <symbol char="\gamma" name="Коэффициент использования грузоподъемности" />
            <symbol char="l_{ег}" name="Пробег с грузом за ездку, км" />
            <symbol char="t_{е}" name="Время одной ездки, ч" />
        </symbols>
    </formula>
    <formula name="Часовая производительность в тонна-километрах (через часовую производительность в тоннах)">
        <latex> W_{ч} = U_{ч} l_{ег} </latex>
        <symbols>
            <symbol char="U_{ч}" name="Часовая производительность в тоннах, т/ч" />
            <symbol char="l_{ег}" name="Пробег с грузом за ездку, км" />
        </symbols>
    </formula>
    <formula name="Производительность в тонна-километрах на 1 т грузоподъемности на автомобиле-тонна-час наряда">
        <latex> W_{qтч} = \beta l_{ег} \gamma </latex>
        <symbols>
            <symbol char="\beta" name="Коэффициент использования пробега" />
            <symbol char="l_{ег}" name="Пробег с грузом за ездку, км" />
            <symbol char="\gamma" name="Коэффициент использования грузоподъемности" />
        </symbols>
    </formula>
</formulas>