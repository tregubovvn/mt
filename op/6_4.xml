<formulas>
    <formula name="Статическое сжимающее усилие (нижний ряд штабеля)">
        <latex> P_{\text{ст}} = g \times Q \times (H - h) / h </latex>
        <symbols>
            <symbol char="g" name="Ускорение свободного падения (9,81), м/с^{2}" />
            <symbol char="Q" name="Масса тары с грузом, кг" />
            <symbol char="H" name="Высота складирования, м" />
            <symbol char="h" name="Высота единицы тары, м" />
        </symbols>
    </formula>

    <formula name="Усилие сжатия с коэффициентом запаса">
        <latex> P_{\text{сж}} = К_{3} \times g \times Q \times (H - h) / h </latex>
        <symbols>
            <symbol char="К_{3}" name="Коэффициент запаса" />
            <symbol char="g" name="Ускорение свободного падения (9,81), м/с^{2}" />
            <symbol char="Q" name="Масса тары с грузом, кг" />
            <symbol char="H" name="Высота складирования, м" />
            <symbol char="h" name="Высота единицы тары, м" />
        </symbols>
    </formula>

    <formula name="Сопротивление сжатия картонной тары">
        <latex> P = P_{\text{Т}} \cdot \delta \cdot Z </latex>
        <symbols>
            <symbol char="P_{\text{Т}}" name="Торцевая жесткость, Н/мм" />
            <symbol char="\delta" name="Толщина картона, мм" />
            <symbol char="Z" name="Периметр ящика, мм" />
        </symbols>
    </formula>

    <formula name="Сжимающее усилие для картонных барабанов (первая формула)">
        <latex> P_{\text{сж}} = Q \cdot g \cdot H / h_{\text{Н}} </latex>
        <symbols>
            <symbol char="Q" name="Масса груза (без учета массы барабана), кг" />
            <symbol char="g" name="Ускорение свободного падения (9,81), м/с^{2}" />
            <symbol char="H" name="Высота складирования, м" />
            <symbol char="h_{\text{Н}}" name="Наружная высота барабана, м" />
        </symbols>
    </formula>

    <formula name="Масса груза в барабане">
        <latex> Q = \pi \cdot d_{\text{В}}^{2} \cdot h_{\text{В}} \cdot \rho / 4 </latex>
        <symbols>
            <symbol char="\pi" name="Число пи (3,14159...)" />
            <symbol char="d_{\text{В}}" name="Внутренний диаметр барабана, м" />
            <symbol char="h_{\text{В}}" name="Внутренняя высота барабана, м" />
            <symbol char="\rho" name="Плотность (объемная масса) груза, кг/м^{3}" />
        </symbols>
    </formula>

    <formula name="Сжимающее усилие для картонных барабанов (итоговая формула)">
        <latex> P_{\text{сж}} = \pi \cdot d_{\text{В}}^{2} \cdot \rho \cdot g \cdot H / 4 </latex>
        <symbols>
            <symbol char="\pi" name="Число пи (3,14159...)" />
            <symbol char="d_{\text{В}}" name="Внутренний диаметр барабана, м" />
            <symbol char="\rho" name="Плотность (объемная масса) груза, кг/м^{3}" />
            <symbol char="g" name="Ускорение свободного падения (9,81), м/с^{2}" />
            <symbol char="H" name="Высота складирования, м" />
        </symbols>
    </formula>
</formulas>