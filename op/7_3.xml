  <!-- Question 1: Fill in the blank (Вместимость склада) -->
  <question type="multichoice">
    <name>
      <text>Вопрос 1: Вместимость склада</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Вместимость склада — это расчетное количество груза, которое единовременно можно хранить на складе. Выберите правильную формулу:</p>
      <p>\[E_{c} = ?\]</p>]]></text>
    </questiontext>
    <answer fraction="100">
      <text><![CDATA[<p>\(E_{c} = 10^{-2} F_{\text{пол}} e\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(E_{c} = F_{\text{пол}} e\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(E_{c} = 10^{-2} F_{\text{пол}} / e\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(E_{c} = \frac{Q_{\text{хр}} \cdot t_{\text{хр}}}{100 \cdot e}\)</p>]]></text>
    </answer>
  </question>

