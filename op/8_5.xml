<formulas>
<formula name="Производительность ПРМ для гидро- или пневмоустановок">
        <latex> W_{з} = 3,6 \rho_{в} \mu Q_{в} \eta_{и} </latex>
        <symbols>
            <symbol char="\rho_{в}" name="Плотность воды или воздуха, кг/м³" />
            <symbol char="\mu" name="Концентрация груза в воде или воздухе, %" />
            <symbol char="Q_{в}" name="Расход воды или воздуха, м³/с" />
            <symbol char="\eta_{и}" name="Коэффициент интенсивности работы" />
        </symbols>
    </formula>
    <formula name="Производительность ПРМ циклического действия">
        <latex> W_{з} = 3600 q_{к} k_{в} \eta_{и} / (T k_{с}) </latex>
        <symbols>
            <symbol char="q_{к}" name="Грузоподъемность (емкость) ковша или масса одновременно поднимаемого груза, т (м³)" />
            <symbol char="k_{в}" name="Коэффициент наполнения" />
            <symbol char="\eta_{и}" name="Коэффициент интенсивности работы" />
            <symbol char="T" name="Продолжительность единичного цикла работы ПРМ, с" />
            <symbol char="k_{с}" name="Коэффициент совмещения операций" />
        </symbols>
    </formula>
    <formula name="Пропускная способность поста в транспортных средствах">
        <latex> M_{а} = 1 / (t_{T} q_{H} \eta_{н}) </latex>
        <symbols>
            <symbol char="t_{T}" name="Время погрузки или разгрузки 1 т груза, ч/т" />
            <symbol char="q_{H}" name="Номинальная вместимость транспортного средства, т" />
            <symbol char="\eta_{н}" name="Коэффициент неравномерности прибытия ТС" />
        </symbols>
    </formula>
    <formula name="Пропускная способность поста в тоннах">
        <latex> M_{т} = 1 / (t_{T} \eta_{н}) </latex>
        <symbols>
            <symbol char="t_{T}" name="Время погрузки или разгрузки 1 т груза, ч/т" />
            <symbol char="\eta_{н}" name="Коэффициент неравномерности прибытия ПС" />
        </symbols>
    </formula>
    <formula name="Коэффициент неравномерности">
        <latex> \eta_{н} = 1 + \sigma(W) / (W_{ср} \sqrt{n_{п}}) </latex>
        <symbols>
            <symbol char="\sigma(W)" name="Среднеквадратическое отклонение объема работ" />
            <symbol char="W_{ср}" name="Средний объем работ" />
            <symbol char="n_{п}" name="Количество постов" />
        </symbols>
    </formula>
    <formula name="Производительность поста (через транспортные средства)">
        <latex> Q_{п} = M_{а} T_{н} </latex>
        <symbols>
            <symbol char="M_{а}" name="Пропускная способность поста в транспортных средствах" />
            <symbol char="T_{н}" name="Время работы поста, ч" />
        </symbols>
    </formula>
    <formula name="Производительность поста (через тонны)">
        <latex> Q_{п} = M_{т} T_{н} </latex>
        <symbols>
            <symbol char="M_{т}" name="Пропускная способность поста в тоннах, т/ч" />
            <symbol char="T_{н}" name="Время работы поста, ч" />
        </symbols>
    </formula>
    <formula name="Число постов для переработки заданного количества груза">
        <latex> N_{п} = Q_{сут} \eta_{н} / (W_{з} T_{н}) </latex>
        <symbols>
            <symbol char="Q_{сут}" name="Суточный объем переработки груза, т" />
            <symbol char="\eta_{н}" name="Коэффициент неравномерности" />
            <symbol char="W_{з}" name="Производительность ПРМ, т/ч" />
            <symbol char="T_{н}" name="Время работы ПРМ, ч" />
        </symbols>
    </formula>
    <formula name="Ритм работы ПРП">
        <latex> R = t_{п(р)} \eta_{н} / N_{п} </latex>
        <symbols>
            <symbol char="t_{п(р)}" name="Время погрузки или разгрузки одного ПС, ч" />
            <symbol char="\eta_{н}" name="Коэффициент неравномерности" />
            <symbol char="N_{п}" name="Количество постов" />
        </symbols>
    </formula>
    <formula name="Интервал движения АТС">
        <latex> A = t_{0} / A_{э} </latex>
        <symbols>
            <symbol char="t_{0}" name="Время оборота АТС, ч" />
            <symbol char="A_{э}" name="Количество АТС в эксплуатации, ед" />
        </symbols>
    </formula>
    <formula name="Число постов для бесперебойного обслуживания АТС">
        <latex> N_{п} = A_{э} t_{п(р)} \eta_{н} / t_{0} </latex>
        <symbols>
            <symbol char="A_{э}" name="Количество АТС в эксплуатации, ед" />
            <symbol char="t_{п(р)}" name="Время погрузки или разгрузки одного ПС, ч" />
            <symbol char="\eta_{н}" name="Коэффициент неравномерности" />
            <symbol char="t_{0}" name="Время оборота АТС, ч" />
        </symbols>
    </formula>
    <formula name="Необходимое число АТС">
        <latex> A_{э} = N_{п} t_{0} / (q_{H} t_{T} \eta_{н}) </latex>
        <symbols>
            <symbol char="N_{п}" name="Количество постов" />
            <symbol char="t_{0}" name="Время оборота АТС, ч" />
            <symbol char="q_{H}" name="Номинальная вместимость транспортного средства, т" />
            <symbol char="t_{T}" name="Время погрузки или разгрузки 1 т груза, ч/т" />
            <symbol char="\eta_{н}" name="Коэффициент неравномерности" />
        </symbols>
    </formula>
    <formula name="Норма выработки">
        <latex> H_{выр} = T_{н} N_{р} / H_{вр} </latex>
        <symbols>
            <symbol char="T_{н}" name="Продолжительность рабочей смены, ч" />
            <symbol char="N_{р}" name="Количество рабочих в бригаде, чел" />
            <symbol char="H_{вр}" name="Норма времени на единицу груза, чел-ч" />
        </symbols>
    </formula>
</formulas>
