  <!-- Вопрос 10: Сопоставление 1 (Выбор формулы для показателя) -->
  <question type="multichoice">
    <name>
      <text>Автомобиле-дни в ремонте</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>По какой формуле можно рассчитать общее количество <strong>автомобиле-дней простоя в ремонте и ожидании ремонта</strong> (\(\text{АД}_{\text{ср}}\)) для парка автомобилей?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>\(\text{АД}_{\text{ср}}\) — это сумма дней простоя в ремонте каждого автомобиля (\(\text{Д}_{\text{р}1} + \text{Д}_{\text{р}2} + \dots\)).</p>]]></text>
    </generalfeedback>
    <answer fraction="100">
      <text><![CDATA[<p>\(\text{АД}_{\text{ср}} = \text{Д}_{\text{р}1} + \text{Д}_{\text{р}2} + \cdots + \text{Д}_{\text{р}n}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(\text{АД}_{\text{ср}} = \text{АД}_{\text{с}} - \text{АД}_{\text{сгэ}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(\text{АД}_{\text{ср}} = \frac{\text{АД}_{\text{сэ}}}{\alpha_{\text{т}}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(\text{АД}_{\text{ср}} = \text{АД}_{\text{сгэ}} \times (1 - \alpha_{\text{т}})\)</p>]]></text>
    </answer>
    <shuffleanswers>1</shuffleanswers>
    <single>true</single>
  </question>

