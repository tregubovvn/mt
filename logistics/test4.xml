  <!-- Вопрос 1: Сопоставление 1 (Выбор формулы для показателя) -->
  <question type="multichoice">
    <name>
      <text>Коэффициент технической готовности</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>Выберите правильную формулу для расчета <strong>коэффициента технической готовности</strong> (\(\alpha_{\text{т}}\)):</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>Коэффициент технической готовности определяется отношением автомобиле-дней в готовом к эксплуатации состоянии к инвентарным автомобиле-дням.</p>]]></text>
    </generalfeedback>
    <answer fraction="100">
      <text><![CDATA[<p>\(\alpha_{\text{т}} = \frac{\text{АД}_{\text{сгэ}}}{\text{АД}_{\text{с}}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(\alpha_{\text{т}} = \frac{\text{АД}_{\text{сэ}}}{\text{АД}_{\text{сгэ}}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(\alpha_{\text{т}} = \frac{\text{АД}_{\text{сгэ}}}{\text{АД}_{\text{ср}}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
      <text><![CDATA[<p>\(\alpha_{\text{т}} = \frac{\text{АД}_{\text{ср}}}{\text{АД}_{\text{с}}}\)</p>]]></text>
    </answer>
    <shuffleanswers>1</shuffleanswers>
    <single>true</single>
  </question>

