      <text><![CDATA[<p>\(\bar{\text{Т}_{\text{н}}} = \frac{\text{АТ}_{\text{СН}}}{\text{АД}_{\text{СЭ}}}\)</p>]]></text>
    </answer>
    <answer fraction="0">
